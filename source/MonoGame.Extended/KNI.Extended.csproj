<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <DefineConstants>$(DefineConstants);KNI</DefineConstants>
        <Description>It makes KNI more awesome.</Description>
        <PackageTags>kni extended pipeline bmfont tiled texture atlas input viewport fps shapes sprite</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="Graphics\Effects\Resources\DefaultEffect.fx" />
      <None Remove="Graphics\Effects\Resources\DefaultEffect.knifxo" />
      <None Remove="Graphics\Effects\Resources\Macros.fxh" />
      <None Remove="Graphics\Effects\Resources\Structures.fxh" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Graphics\Effects\Resources\DefaultEffect.knifxo">
            <LogicalName>MonoGame.Extended.Graphics.Effects.Resources.DefaultEffect.fxo</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Graphics\Effects\Resources\DefaultEffect.fx" />
        <EmbeddedResource Include="Graphics\Effects\Resources\Macros.fxh" />
        <EmbeddedResource Include="Graphics\Effects\Resources\Structures.fxh" />
    </ItemGroup>

    <!-- Allow Test project to access internals -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Kni.Extended.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Kni.Extended.Content.Pipeline</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
